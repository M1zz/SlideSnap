    "탭하면 장표스냅 카메라가 바로 열려요. 홈 화면과 잠금화면에서 쓸 수 있어요." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap to open the CatchSlide camera right away. Works on the Home Screen and Lock Screen."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap to open the CatchSlide camera right away. Works on the Home Screen and Lock Screen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点即可直接打开 CatchSlide 相机。可在主屏幕和锁定屏幕上使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輕點即可直接開啟 CatchSlide 相機。可用於主畫面與鎖定畫面。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タップするとCatchSlideのカメラがすぐに開きます。ホーム画面とロック画面で使えます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите, чтобы сразу открыть камеру CatchSlide. Работает на экране «Домой» и на экране блокировки."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca para abrir la cámara de CatchSlide al instante. Funciona en la pantalla de inicio y en la pantalla bloqueada."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippen, um die CatchSlide-Kamera sofort zu öffnen. Verfügbar auf dem Home-Bildschirm und dem Sperrbildschirm."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez pour ouvrir aussitôt l’appareil photo de CatchSlide. Disponible sur l’écran d’accueil et l’écran de verrouillage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca per aprire subito la fotocamera di CatchSlide. Funziona nella schermata Home e nella schermata di blocco."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque para abrir a câmera do CatchSlide na hora. Funciona na Tela de Início e na Tela Bloqueada."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะเพื่อเปิดกล้อง CatchSlide ทันที ใช้ได้ทั้งบนหน้าจอโฮมและหน้าจอล็อก"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm để mở ngay camera CatchSlide. Dùng được trên Màn hình chính và Màn hình khóa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepnutím hned otevřeš fotoaparát CatchSlide. Funguje na domovské obrazovce i na zamčené obrazovce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk for at åbne CatchSlide-kameraet med det samme. Virker på hjemmeskærmen og låseskærmen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε για να ανοίξει αμέσως η κάμερα του CatchSlide. Λειτουργεί στην Αρχική οθόνη και στην Οθόνη κλειδώματος."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta, niin CatchSlide-kamera avautuu heti. Toimii Koti- ja Lukitusnäytöllä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk untuk langsung membuka kamera CatchSlide. Bisa dipakai di Layar Utama dan Layar Kunci."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk for å åpne CatchSlide-kameraet med én gang. Fungerer på Hjem-skjermen og låseskjermen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik om de CatchSlide-camera meteen te openen. Werkt op het beginscherm en het toegangsscherm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotknij, aby od razu otworzyć aparat CatchSlide. Działa na ekranie początkowym i ekranie blokady."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck för att öppna CatchSlide-kameran direkt. Fungerar på hemskärmen och låsskärmen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokunduğunuzda CatchSlide kamerası hemen açılır. Ana Ekran'da ve Kilit Ekranı'nda kullanılabilir."
          }
        }
      }
    },
