        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CatchSlide dùng camera để chụp slide thuyết trình."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CatchSlide používá fotoaparát k focení slajdů prezentací."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CatchSlide bruger kameraet til at tage billeder af præsentationsslides."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το CatchSlide χρησιμοποιεί την κάμερα για να φωτογραφίζει διαφάνειες παρουσιάσεων."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CatchSlide käyttää kameraa esityskalvojen kuvaamiseen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CatchSlide menggunakan kamera untuk memotret slide presentasi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CatchSlide bruker kameraet til å ta bilder av presentasjonslysbilder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CatchSlide gebruikt de camera om presentatiedia's vast te leggen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CatchSlide korzysta z aparatu, aby fotografować slajdy prezentacji."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CatchSlide använder kameran för att ta bilder av presentationsslides."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CatchSlide, sunum slaytlarını çekmek için kamerayı kullanır."
          }
        }
