          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CatchSlide necesita la cámara para capturar diapositivas de presentaciones."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CatchSlide verwendet die Kamera, um Präsentationsfolien aufzunehmen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CatchSlide utilise l’appareil photo pour capturer les diapositives de présentation."
