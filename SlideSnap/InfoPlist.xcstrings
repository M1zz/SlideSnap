    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SlideSnap records the talk while you capture slides so you can replay what was said on each slide."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장표를 찍는 동안 발표 내용을 녹음해 장표별로 다시 들을 수 있게 합니다."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SlideSnap transcribes your recordings on device so you can read and search what was said on each slide."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "녹음한 발표를 기기 안에서 글로 받아써 장표별로 보여 주고 검색할 수 있게 합니다."
          }
        }
      }
