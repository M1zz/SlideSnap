    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CatchSlide uses the camera to capture presentation slides."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "발표 장표를 촬영하기 위해 카메라 접근이 필요합니다."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CatchSlide uses the camera to capture presentation slides."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CatchSlide 需要使用相机来拍摄演示幻灯片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CatchSlide 需要使用相機來拍攝簡報投影片。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CatchSlideは、プレゼンのスライドを撮影するためにカメラを使用します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
