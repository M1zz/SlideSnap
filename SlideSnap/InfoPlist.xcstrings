        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CatchSlide usa la fotocamera per catturare le diapositive delle presentazioni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O CatchSlide usa a câmera para capturar slides de apresentações."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CatchSlide ใช้กล้องเพื่อถ่ายสไลด์งานนำเสนอ"
