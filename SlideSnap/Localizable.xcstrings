    "오른쪽 위 + 버튼으로 새 발표를 만들고\n장표를 촬영해 보세요." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap + at the top right to create a presentation\nand start capturing slides."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap + at the top right to create a presentation\nand start capturing slides."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按右上角的 + 按钮新建演示，\n开始拍摄幻灯片吧。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下右上角的 + 按鈕新增簡報，\n開始拍攝投影片吧。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右上の＋ボタンで新しいプレゼンを作成して、\nスライドを撮影してみましょう。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите «+» в правом верхнем углу, чтобы создать презентацию\nи начать снимать слайды."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca + arriba a la derecha para crear una presentación\ny empezar a capturar diapositivas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe oben rechts auf +, um eine Präsentation anzulegen\nund Folien aufzunehmen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez + en haut à droite pour créer une présentation\net commencer à capturer des diapositives."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca + in alto a destra per creare una presentazione\ne iniziare a catturare le diapositive."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em + no canto superior direito para criar uma apresentação\ne começar a capturar slides."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะ + ที่มุมขวาบนเพื่อสร้างงานนำเสนอ\nแล้วเริ่มถ่ายสไลด์ได้เลย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn + ở góc trên bên phải để tạo bài thuyết trình\nvà bắt đầu chụp slide."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepni na „+“ vpravo nahoře, vytvoř prezentaci\na začni fotit slajdy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på + øverst til højre for at oprette en præsentation\nog begynde at tage billeder af slides."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε + πάνω δεξιά για να δημιουργήσετε μια παρουσίαση\nκαι ξεκινήστε να φωτογραφίζετε διαφάνειες."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luo esitys napauttamalla + oikeasta yläkulmasta\nja aloita kalvojen kuvaaminen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk + di kanan atas untuk membuat presentasi\ndan mulai memotret slide."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på + øverst til høyre for å opprette en presentasjon\nog begynne å ta bilder av lysbilder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
