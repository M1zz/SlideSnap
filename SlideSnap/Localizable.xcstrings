          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistaa varjot ja haalean kontrastin, jotta teksti erottuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime ombres et contraste terne pour un texte net."
          }
