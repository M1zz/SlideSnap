          }
        }
      }
    },
    "Siri에게 앱 이름을 말하지 않아도 장표를 찾아 바로 열어요." : {
      "comment" : "Roadmap item detail: siri-ai",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri najde a otevře vaše slajdy, i když neřeknete název aplikace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri finder og åbner dine slides, også selvom du ikke siger appens navn."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri findet und öffnet deine Folien, auch wenn du den App-Namen nicht nennst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η Siri βρίσκει και ανοίγει τις διαφάνειές σας, ακόμη κι αν δεν πείτε το όνομα της εφαρμογής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find and open your slides with Siri, even without saying the app’s name."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find and open your slides with Siri, even without saying the app’s name."
