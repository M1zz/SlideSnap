    "최근에 찍었거나 지금 캘린더 일정이 있으면 카메라부터, 아니면 발표 목록부터 보여요." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud jsi právě fotil nebo teď probíhá událost v kalendáři, otevře se fotoaparát, jinak seznam prezentací."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbner kameraet, hvis du lige har taget billeder eller en kalenderbegivenhed er i gang, ellers dine præsentationer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet die Kamera, wenn du gerade aufgenommen hast oder ein Kalendertermin läuft, sonst deine Präsentationen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανοίγει την κάμερα αν μόλις τραβούσατε ή αν τρέχει τώρα συμβάν ημερολογίου, αλλιώς τις παρουσιάσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens the camera if you were just capturing or a calendar event is on now; otherwise shows your presentations."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens the camera if you were just capturing or a calendar event is on now; otherwise shows your presentations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre la cámara si acabas de capturar o hay un evento del calendario en curso; si no, muestra tus presentaciones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa kameran, jos kuvasit juuri tai kalenteritapahtuma on käynnissä, muuten esitykset."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre l’appareil photo si vous veniez de capturer ou si un événement est en cours, sinon vos présentations."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membuka kamera jika Anda baru saja memotret atau ada acara kalender yang sedang berlangsung; jika tidak, daftar presentasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apre la fotocamera se stavi scattando o c’è un evento in corso nel calendario, altrimenti le presentazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "少し前まで撮っていた時やカレンダーの予定中はカメラから、それ以外は発表の一覧から始まります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åpner kameraet hvis du nettopp tok bilder eller en kalenderhendelse pågår, ellers presentasjonene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opent de camera als je net aan het vastleggen was of er nu een agenda-item loopt, anders je presentaties."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwiera aparat, jeśli przed chwilą robiłeś zdjęcia albo trwa wydarzenie z kalendarza, w innym razie listę prezentacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre a câmera se você acabou de capturar ou há um evento em andamento na agenda; senão, mostra suas apresentações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вы недавно снимали или сейчас идёт событие из календаря, откроется камера, иначе — список презентаций."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppnar kameran om du nyss fotade eller en kalenderhändelse pågår, annars dina presentationer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้าเพิ่งถ่ายหรือมีนัดในปฏิทินอยู่ตอนนี้ จะเปิดกล้องก่อน ไม่เช่นนั้นจะแสดงรายการงานนำเสนอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az önce çekim yaptıysanız ya da şu an bir takvim etkinliği varsa kamerayı, yoksa sunumlarınızı açar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mở camera nếu bạn vừa chụp hoặc đang có sự kiện trong lịch, nếu không sẽ hiện danh sách bài thuyết trình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果刚刚在拍摄或日历中有正在进行的日程，先打开相机；否则先显示演示列表。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果剛剛在拍攝或行事曆中有正在進行的行程，先打開相機；否則先顯示簡報列表。"
          }
        }
      }
    },
