    "같은 Apple ID로 로그인한 iPhone·iPad·Mac에서 발표·장표·녹음을 함께 봐요. 사진과 녹음이 iCloud 저장 공간을 사용해요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See your decks, slides and recordings on every iPhone, iPad and Mac signed in with the same Apple ID. Photos and recordings use your iCloud storage."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See your decks, slides and recordings on every iPhone, iPad and Mac signed in with the same Apple Account. Photos and recordings use your iCloud storage."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在登录同一 Apple 账户的 iPhone、iPad 和 Mac 上查看演示、幻灯片和录音。照片和录音会占用 iCloud 存储空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在登入同一個 Apple 帳號的 iPhone、iPad 和 Mac 上查看簡報、投影片與錄音。照片和錄音會佔用 iCloud 儲存空間。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じApple AccountでサインインしたiPhone・iPad・Macで、プレゼン、スライド、録音を見られます。写真と録音はiCloudの容量を使用します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Презентации, слайды и записи будут на всех iPhone, iPad и Mac, где выполнен вход с вашим Apple ID. Фото и записи занимают место в хранилище iCloud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta tus presentaciones, diapositivas y grabaciones en todos los iPhone, iPad y Mac con el mismo ID de Apple. Las fotos y las grabaciones ocupan espacio de iCloud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greife auf allen iPhone-, iPad- und Mac-Geräten, die mit demselben Apple-Account angemeldet sind, auf Präsentationen, Folien und Aufnahmen zu. Fotos und Aufnahmen belegen Speicherplatz in iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retrouvez vos présentations, diapositives et enregistrements sur tous les iPhone, iPad et Mac connectés au même compte Apple. Les photos et enregistrements occupent de l’espace iCloud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritrova presentazioni, diapositive e registrazioni su ogni iPhone, iPad e Mac con lo stesso ID Apple. Foto e registrazioni occupano spazio su iCloud."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja suas apresentações, slides e gravações em todos os iPhones, iPads e Macs conectados ao mesmo ID Apple. Fotos e gravações ocupam espaço do iCloud."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดูงานนำเสนอ สไลด์ และเสียงบันทึกบน iPhone, iPad และ Mac ทุกเครื่องที่ลงชื่อเข้าใช้ด้วย Apple ID เดียวกัน รูปภาพและเสียงบันทึกจะใช้พื้นที่ iCloud ของคุณ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xem bài thuyết trình, slide và bản ghi âm trên mọi iPhone, iPad và Mac đăng nhập cùng một Apple ID. Ảnh và bản ghi âm sẽ dùng dung lượng iCloud của bạn."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prezentace, slajdy a nahrávky uvidíš na každém iPhonu, iPadu a Macu přihlášeném pod stejným Apple ID. Fotky a nahrávky zabírají místo v úložišti iCloudu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se dine præsentationer, slides og optagelser på alle iPhone, iPad og Mac, der er logget ind med samme Apple-konto. Fotos og optagelser bruger din iCloud-lagerplads."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δείτε παρουσιάσεις, διαφάνειες και ηχογραφήσεις σε κάθε iPhone, iPad και Mac με το ίδιο Apple ID. Οι φωτογραφίες και οι ηχογραφήσεις καταλαμβάνουν χώρο στο iCloud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näe esitykset, kalvot ja äänitteet kaikilla iPhone-, iPad- ja Mac-laitteilla, joihin olet kirjautunut samalla Apple ID:llä. Kuvat ja äänitteet käyttävät iCloud-tilaa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lihat presentasi, slide, dan rekaman Anda di semua iPhone, iPad, dan Mac yang masuk dengan Apple ID yang sama. Foto dan rekaman menggunakan penyimpanan iCloud Anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se presentasjonene, lysbildene og opptakene dine på alle iPhone-, iPad- og Mac-enheter som er logget på med samme Apple-konto. Bilder og opptak bruker iCloud-lagringen din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekijk je presentaties, dia's en opnamen op elke iPhone, iPad en Mac waarop je met dezelfde Apple Account bent ingelogd. Foto's en opnamen gebruiken je iCloud-opslag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeglądaj prezentacje, slajdy i nagrania na każdym iPhonie, iPadzie i Macu zalogowanym tym samym Apple ID. Zdjęcia i nagrania zajmują miejsce w iCloud."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se dina presentationer, slides och inspelningar på alla iPhone-, iPad- och Mac-enheter som är inloggade med samma Apple-konto. Foton och inspelningar använder ditt iCloud-lagringsutrymme."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aynı Apple Hesabıyla oturum açtığınız tüm iPhone, iPad ve Mac'lerde sunumlarınızı, slaytlarınızı ve kayıtlarınızı görün. Fotoğraflar ve kayıtlar iCloud depolama alanınızı kullanır."
          }
        }
      }
    },
