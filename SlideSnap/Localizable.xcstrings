      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Sync"
          }
        }
      }
    },
    "iCloud 저장 공간이 부족해요.": {
      "localizations": {
        "en": {
          "stringUnit": {
