    "장표 글자와 받아쓴 발표 내용으로 핵심만 정리해요. 기기 안에서 처리되어 밖으로 나가지 않아요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulls out the key points from slide text and transcripts. Everything stays on your device."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulls out the key points from slide text and transcripts. Everything stays on your device."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据幻灯片文字和转写内容提炼要点。全部在设备上处理，不会发送到外部。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根據投影片文字與轉錄內容整理重點。所有處理都在裝置上進行，不會傳送到外部。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スライドの文字と文字起こしした内容から、要点をまとめます。処理はデバイス内で行われ、外部には送信されません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выделяет главное из текста слайдов и расшифровок. Всё обрабатывается на устройстве и никуда не передаётся."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extrae los puntos clave del texto de las diapositivas y de las transcripciones. Todo se queda en tu dispositivo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fasst die wichtigsten Punkte aus Folientext und Transkripten zusammen. Alles bleibt auf deinem Gerät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dégage l’essentiel à partir du texte des diapositives et des transcriptions. Tout reste sur votre appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estrae i punti chiave dal testo delle diapositive e dalle trascrizioni. Tutto resta sul tuo dispositivo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extrai os pontos principais do texto dos slides e das transcrições. Tudo fica no seu dispositivo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สรุปประเด็นสำคัญจากข้อความบนสไลด์และเนื้อหาที่ถอดเสียง ประมวลผลบนอุปกรณ์ของคุณ ไม่ส่งออกไปที่ใด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rút ra các ý chính từ chữ trên slide và văn bản chép lời. Mọi thứ được xử lý ngay trên thiết bị của bạn."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vybere to nejdůležitější z textu slajdů a z přepisů. Vše se zpracuje v zařízení a nikam se neodesílá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udtrækker hovedpunkterne fra slidetekst og transskriptioner. Alt bliver på din enhed."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εντοπίζει τα βασικά σημεία από το κείμενο των διαφανειών και τις μεταγραφές. Όλα γίνονται στη συσκευή σας."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poimii avainkohdat kalvojen tekstistä ja litteraateista. Kaikki käsitellään laitteellasi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merangkum poin penting dari teks slide dan transkrip. Semuanya diproses di perangkat Anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henter ut hovedpunktene fra lysbildetekst og transkripsjoner. Alt blir på enheten din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haalt de hoofdpunten uit de tekst op de dia's en uit de transcripties. Alles blijft op je apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyciąga najważniejsze punkty z tekstu slajdów i transkrypcji. Wszystko dzieje się na urządzeniu i nigdzie nie jest wysyłane."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plockar fram huvudpunkterna ur slidetext och transkriptioner. Allt stannar på din enhet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
