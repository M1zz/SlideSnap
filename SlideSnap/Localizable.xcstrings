    "녹음은 촬영 화면이 떠 있는 동안 이어져요. 다른 앱으로 가거나 화면을 잠그면 멈췄다가, 돌아오면 다시 이어서 녹음해요." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahrávání běží, dokud je na obrazovce fotoaparát. Když přepnete do jiné aplikace nebo zamknete obrazovku, pozastaví se a po návratu pokračuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optagelsen kører, så længe kameraet er på skærmen. Den holder pause, hvis du skifter app eller låser skærmen, og fortsætter, når du kommer tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aufnahme läuft, solange die Kamera zu sehen ist. Sie pausiert, wenn du die App wechselst oder den Bildschirm sperrst, und läuft weiter, sobald du zurück bist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εγγραφή συνεχίζεται όσο η κάμερα είναι στην οθόνη. Διακόπτεται αν αλλάξετε εφαρμογή ή κλειδώσετε την οθόνη και συνεχίζει όταν επιστρέψετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recording runs while the camera is on screen. It pauses if you switch apps or lock the screen, and picks up again when you come back."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recording runs while the camera is on screen. It pauses if you switch apps or lock the screen, and picks up again when you come back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grabación sigue mientras la cámara está en pantalla. Se pausa si cambias de app o bloqueas la pantalla y continúa cuando vuelves."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Äänitys jatkuu niin kauan kuin kamera on näytöllä. Se keskeytyy, jos vaihdat appia tai lukitset näytön, ja jatkuu, kun palaat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrement continue tant que l’appareil photo est à l’écran. Il se met en pause si vous changez d’app ou verrouillez l’écran, puis reprend à votre retour."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perekaman berjalan selama kamera tampil di layar. Perekaman dijeda jika Anda berpindah app atau mengunci layar, lalu berlanjut saat Anda kembali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La registrazione continua finché la fotocamera è sullo schermo. Va in pausa se cambi app o blocchi lo schermo e riprende quando torni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録音はカメラ画面を開いている間つづきます。ほかのアプリに移ったり画面をロックしたりすると止まり、戻ると続きから録音します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opptaket går så lenge kameraet er på skjermen. Det settes på pause hvis du bytter app eller låser skjermen, og fortsetter når du kommer tilbake."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De opname loopt zolang de camera in beeld is. Ze pauzeert als je van app wisselt of het scherm vergrendelt en gaat verder zodra je terug bent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagrywanie trwa, dopóki aparat jest na ekranie. Wstrzymuje się, gdy przełączysz aplikację lub zablokujesz ekran, i rusza dalej po powrocie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gravação continua enquanto a câmera está na tela. Ela pausa se você trocar de app ou bloquear a tela e continua quando você volta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запись идёт, пока камера на экране. Она приостанавливается, если переключиться на другое приложение или заблокировать экран, и продолжается, когда вы вернётесь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspelningen pågår så länge kameran visas på skärmen. Den pausas om du byter app eller låser skärmen och fortsätter när du kommer tillbaka."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การอัดเสียงจะทำงานต่อเนื่องขณะที่หน้ากล้องเปิดอยู่ หากสลับไปแอปอื่นหรือล็อกหน้าจอจะหยุดชั่วคราว และอัดต่อเมื่อกลับมา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayıt, kamera ekrandayken sürer. Başka bir uygulamaya geçerseniz veya ekranı kilitlerseniz duraklar, döndüğünüzde kaldığı yerden devam eder."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc ghi âm tiếp tục khi màn hình camera đang mở. Ghi âm tạm dừng nếu bạn chuyển ứng dụng hoặc khóa màn hình, và tiếp tục khi bạn quay lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相机画面开着时会一直录音。切换到其他 App 或锁定屏幕时会暂停，回来后继续录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相機畫面開著時會持續錄音。切換到其他 App 或鎖定螢幕時會暫停，回來後繼續錄。"
          }
        }
      }
    },
