    "방금 찍은 장표는 가장 최근 발표에 담았어요. 새 발표로 따로 묶으려면 Plus가 필요해요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Právě pořízené slajdy jsme uložili do poslední prezentace. Na novou samostatnou prezentaci potřebuješ Plus."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De slides, du lige har taget, er gemt i din seneste præsentation. Hvis de skal være en ny præsentation, skal du have Plus."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine gerade aufgenommenen Folien sind in der letzten Präsentation gespeichert. Für eine eigene neue Präsentation brauchst du Plus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι διαφάνειες που μόλις τραβήξατε αποθηκεύτηκαν στην πιο πρόσφατη παρουσίαση. Για να γίνουν νέα παρουσίαση, χρειάζεστε το Plus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The slides you just captured were saved to your latest presentation. To keep them as a new presentation, you need Plus."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The slides you just captured were saved to your latest presentation. To keep them as a new presentation, you need Plus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las diapositivas que acabas de capturar se guardaron en tu presentación más reciente. Para tenerlas en una presentación nueva, necesitas Plus."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juuri kuvaamasi kalvot tallennettiin viimeisimpään esitykseen. Jos haluat niistä uuden esityksen, tarvitset Plusin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les diapositives que vous venez de capturer ont été ajoutées à votre dernière présentation. Pour en faire une nouvelle présentation, il vous faut Plus."
          }
        },
        "id" : {
          "stringUnit" : {
