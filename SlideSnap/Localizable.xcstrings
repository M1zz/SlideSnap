    "설정 ▸ Apple Intelligence 및 Siri에서 Apple Intelligence를 켜면 AI 요약을 쓸 수 있어요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shrnutí od AI zapneš v Nastavení > Apple Intelligence a Siri zapnutím Apple Intelligence."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå Apple Intelligence til i Indstillinger > Apple Intelligence og Siri for at bruge AI-resumé."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere Apple Intelligence unter Einstellungen > Apple Intelligence & Siri, um die KI-Zusammenfassung zu nutzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενεργοποιήστε το Apple Intelligence στις Ρυθμίσεις > Apple Intelligence και Siri για να χρησιμοποιήσετε τη Σύνοψη AI."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on Apple Intelligence in Settings > Apple Intelligence & Siri to use AI Summary."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on Apple Intelligence in Settings > Apple Intelligence & Siri to use AI Summary."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa Apple Intelligence en Ajustes > Apple Intelligence y Siri para usar el resumen con IA."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota Apple Intelligence käyttöön kohdassa Asetukset > Apple Intelligence ja Siri, niin voit käyttää tekoälytiivistelmää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez Apple Intelligence dans Réglages > Apple Intelligence et Siri pour utiliser le résumé IA."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktifkan Apple Intelligence di Pengaturan > Apple Intelligence & Siri untuk memakai Ringkasan AI."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva Apple Intelligence in Impostazioni > Apple Intelligence e Siri per usare il riepilogo IA."
          }
