    "선택한 %lld개 발표를 하나로 합칩니다.\n장표는 목록 순서대로 이어 붙고, 되돌릴 수 없어요." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merge the %lld selected presentations into one?\nSlides are joined in list order. This can't be undone."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merge the %lld selected presentations into one?\nSlides are joined in list order. This can't be undone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将所选的 %lld 个演示合并为一个。\n幻灯片按列表顺序依次拼接，且无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將所選的 %lld 個簡報合併為一個。\n投影片會依列表順序接在一起，且無法還原。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した%lld件のプレゼンを1つに結合します。\nスライドは一覧の順に連結され、元に戻せません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Объединить выбранные презентации (%lld) в одну?\nСлайды пойдут друг за другом в порядке списка. Отменить это действие нельзя."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Combinar las %lld presentaciones seleccionadas en una sola?\nLas diapositivas se unen en el orden de la lista. No se puede deshacer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die %lld ausgewählten Präsentationen zu einer zusammenführen?\nDie Folien werden in der Reihenfolge der Liste aneinandergehängt. Das lässt sich nicht rückgängig machen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fusionner les %lld présentations sélectionnées en une seule ?\nLes diapositives sont placées bout à bout dans l’ordre de la liste. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unire in una sola le %lld presentazioni selezionate?\nLe diapositive vengono accodate nell'ordine dell'elenco. L'operazione non si può annullare."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesclar as %lld apresentações selecionadas em uma só?\nOs slides são unidos na ordem da lista. Não é possível desfazer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รวมงานนำเสนอที่เลือก %lld รายการเป็นรายการเดียว\nสไลด์จะต่อกันตามลำดับในรายการ และย้อนกลับไม่ได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gộp %lld bài thuyết trình đã chọn thành một?\nCác slide sẽ nối tiếp nhau theo thứ tự trong danh sách và không thể hoàn tác."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sloučit vybrané prezentace (%lld) do jedné?\nSlajdy se spojí v pořadí podle seznamu. Tuto akci nelze vrátit zpět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du flette de %lld valgte præsentationer til én?\nSlides sættes sammen i listens rækkefølge. Det kan ikke fortrydes."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Να συγχωνευθούν οι %lld επιλεγμένες παρουσιάσεις σε μία;\nΟι διαφάνειες ενώνονται με τη σειρά της λίστας. Η ενέργεια δεν μπορεί να αναιρεθεί."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhdistetäänkö valitut %lld esitystä yhdeksi?\nKalvot liitetään luettelon järjestyksessä. Tätä ei voi kumota."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gabungkan %lld presentasi yang dipilih menjadi satu?\nSlide disambung sesuai urutan di daftar, dan tindakan ini tidak dapat dibatalkan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du slå sammen de %lld valgte presentasjonene til én?\nLysbildene settes sammen i listerekkefølge. Dette kan ikke angres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De %lld geselecteerde presentaties samenvoegen tot één?\nDe dia's worden in de volgorde van de lijst achter elkaar gezet. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
