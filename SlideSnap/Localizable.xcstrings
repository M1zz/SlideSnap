    "그림자와 흐린 대비를 걷어 글자를 살려요" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstraní stíny a mdlý kontrast, aby text vynikl."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerner skygger og mat kontrast, så teksten står skarpt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt Schatten und flauen Kontrast, damit Text klar wird."
