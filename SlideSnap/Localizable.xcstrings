    "그때 한 말까지 장표 옆에, 요약은 기기가 알아서." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co zaznělo, hned vedle každého slajdu, a shrnutí udělá zařízení samo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det, der blev sagt, lige ved hver slide – og resuméet laver enheden selv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gesagte direkt neben jeder Folie, zusammengefasst auf deinem Gerät."
