    "불편한 점이나 개선했으면 하는 점이 있으신가요?\n작은 의견도 앱을 더 좋게 만드는 데 큰 도움이 돼요." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anything bothering you, or something you'd like improved?\nEven small feedback helps make the app better."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anything bothering you, or something you'd like improved?\nEven small feedback helps make the app better."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有哪里用着不顺手，或是希望改进的地方吗？\n哪怕是小小的意见，也能帮我们把 App 做得更好。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有哪裡用起來不順手，或希望改進的地方嗎？\n再小的意見，都能幫助我們把 App 做得更好。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使いにくい点や、改善してほしい点はありますか？\nちょっとしたご意見も、アプリをよくするための大きな力になります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что-то не устраивает или хочется, чтобы работало лучше?\nДаже небольшой отзыв помогает сделать приложение лучше."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Algo te molesta o te gustaría que mejorara?\nHasta los comentarios más pequeños ayudan a mejorar la app."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt es etwas, das dich stört oder das wir verbessern sollten?\nAuch kleine Hinweise helfen uns, die App besser zu machen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un souci, une idée d’amélioration ?\nMême un petit commentaire nous aide à améliorer l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'è qualcosa che non ti convince o che vorresti migliorare?\nAnche un piccolo suggerimento aiuta a rendere l'app migliore."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo incomoda você ou você gostaria que melhorasse?\nMesmo pequenos comentários ajudam a deixar o app melhor."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีอะไรที่ไม่สะดวก หรืออยากให้ปรับปรุงไหม\nข้อเสนอแนะเล็ก ๆ ก็ช่วยให้แอปดีขึ้นได้มาก"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có điều gì khiến bạn chưa hài lòng hoặc muốn cải thiện không?\nMột góp ý nhỏ cũng giúp ứng dụng tốt hơn rất nhiều."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Něco ti vadí, nebo bys chtěl něco vylepšit?\nI malý postřeh pomáhá dělat aplikaci lepší."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er der noget, der irriterer dig, eller noget, du gerne vil have forbedret?\nSelv små tilbagemeldinger hjælper os med at gøre appen bedre."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σας ενοχλεί κάτι ή θα θέλατε κάποια βελτίωση;\nΑκόμη και ένα μικρό σχόλιο βοηθά να γίνει η εφαρμογή καλύτερη."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onko jokin vaivannut tai haluaisitko parannuksia?\nPienikin palaute auttaa tekemään sovelluksesta paremman."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ada yang kurang nyaman atau ingin ditingkatkan?\nMasukan sekecil apa pun sangat membantu membuat aplikasi ini lebih baik."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er det noe som irriterer deg, eller noe du skulle ønske var bedre?\nSelv små tilbakemeldinger hjelper oss å gjøre appen bedre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zit je iets dwars, of wil je dat we iets verbeteren?\nOok kleine opmerkingen helpen om de app beter te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coś Ci przeszkadza albo chciałbyś coś ulepszyć?\nNawet drobna uwaga pomaga ulepszać aplikację."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Är det något som stör dig, eller något du vill ha förbättrat?\nÄven små synpunkter hjälper oss att göra appen bättre."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sizi rahatsız eden bir şey ya da geliştirilmesini istediğiniz bir yer var mı?\nKüçük geri bildirimler bile uygulamayı daha iyi yapmamıza yardımcı olur."
          }
        }
      }
    },
