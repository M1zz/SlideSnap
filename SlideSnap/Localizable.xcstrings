    "대비를 높이거나 색을 구별하기 어려워도 내용을 알아볼 수 있어요." : {
      "comment" : "Roadmap item detail: colors and contrast",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything stays readable with higher contrast or if colors are hard to tell apart."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything stays readable with higher contrast or if colours are hard to tell apart."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提高对比度，或在难以分辨颜色时，内容依然清晰可辨。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提高對比，或在難以分辨顏色時，內容依然清楚可辨。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントラストを高めたり、色の区別がつきにくい場合でも、内容を読み取れます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё остаётся читаемым при повышенной контрастности и если трудно различать цвета."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo se lee bien con más contraste o si cuesta distinguir los colores."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles bleibt lesbar – auch mit erhöhtem Kontrast oder bei Farbsehschwäche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout reste lisible avec un contraste renforcé ou si vous distinguez mal les couleurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto resta leggibile con più contrasto o se fai fatica a distinguere i colori."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo continua legível com mais contraste ou se for difícil distinguir as cores."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มคอนทราสต์ หรือแม้แยกสีได้ยาก ก็ยังอ่านเนื้อหาได้ชัดเจน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nội dung vẫn dễ đọc khi tăng độ tương phản hoặc khi khó phân biệt màu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vše zůstává čitelné i při vyšším kontrastu nebo když je těžké barvy rozlišit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt er stadig læsbart med højere kontrast, eller hvis farver er svære at skelne."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλα παραμένουν ευανάγνωστα με υψηλότερη αντίθεση ή αν δυσκολεύεστε να ξεχωρίσετε χρώματα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki pysyy luettavana korkeammalla kontrastilla tai jos värejä on vaikea erottaa."
