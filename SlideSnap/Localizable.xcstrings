    "요약할 내용이 없어요. 장표 글자를 인식하거나 녹음을 받아쓴 뒤 다시 시도해 주세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is nothing to summarize yet. Wait for slide text to be recognized or transcribe a recording, then try again."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is nothing to summarise yet. Wait for slide text to be recognised or transcribe a recording, then try again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂时没有可摘要的内容。请等待幻灯片文字识别完成，或先转写录音，然后再试一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前沒有可摘要的內容。請等待投影片文字辨識完成，或先轉錄錄音，然後再試一次。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要約する内容がまだありません。スライドの文字が認識されるのを待つか、録音を文字起こししてから、もう一度お試しください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока не из чего делать выводы. Дождитесь распознавания текста на слайдах или расшифруйте запись и повторите попытку."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía no hay nada que resumir. Espera a que se reconozca el texto de las diapositivas o transcribe una grabación y vuelve a intentarlo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt noch nichts zusammenzufassen. Warte, bis der Folientext erkannt ist, oder transkribiere eine Aufnahme, und versuche es dann erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n’y a encore rien à résumer. Attendez la reconnaissance du texte des diapositives ou transcrivez un enregistrement, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non c'è ancora nulla da riassumere. Attendi il riconoscimento del testo delle diapositive o trascrivi una registrazione, poi riprova."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não há nada para resumir. Aguarde o reconhecimento do texto dos slides ou transcreva uma gravação e tente novamente."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังไม่มีเนื้อหาให้สรุป รอให้จดจำข้อความบนสไลด์เสร็จ หรือถอดเสียงจากการบันทึกก่อน แล้วลองอีกครั้ง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chưa có nội dung để tóm tắt. Hãy chờ nhận dạng chữ trên slide hoặc chép lời bản ghi âm, rồi thử lại."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatím není co shrnout. Počkej na rozpoznání textu na slajdech nebo přepiš nahrávku a zkus to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er intet at resumere endnu. Vent på, at slideteksten er genkendt, eller transskribér en optagelse, og prøv igen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχει ακόμη κάτι για σύνοψη. Περιμένετε να αναγνωριστεί το κείμενο των διαφανειών ή κάντε μεταγραφή μιας ηχογράφησης και δοκιμάστε ξανά."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiivistettävää ei vielä ole. Odota, että kalvojen teksti tunnistetaan, tai litteroi äänite ja yritä sitten uudelleen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum ada yang bisa diringkas. Tunggu teks slide selesai dikenali atau transkripsikan rekaman, lalu coba lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
