    "이 Apple 계정에서 구매한 기록을 찾지 못했어요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U tohoto Apple účtu jsme nenašli žádné nákupy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi fandt ingen køb på denne Apple-konto."
          }
        },
