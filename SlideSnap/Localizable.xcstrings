        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定」>「Apple IntelligenceとSiri」でApple Intelligenceをオンにすると、AI要約を使えます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
