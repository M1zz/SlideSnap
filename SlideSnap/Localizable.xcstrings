        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isi tetap terbaca dengan kontras lebih tinggi, juga bagi yang sulit membedakan warna."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt er fortsatt lesbart med høyere kontrast eller hvis det er vanskelig å skille farger fra hverandre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
