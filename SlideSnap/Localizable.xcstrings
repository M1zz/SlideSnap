          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet Apple Intelligence aan via Instellingen > Apple Intelligence en Siri om AI-samenvatting te gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby korzystać z podsumowań AI, włącz Apple Intelligence w Ustawienia > Apple Intelligence i Siri."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
