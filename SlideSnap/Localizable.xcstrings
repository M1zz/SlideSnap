    "발표 목록부터 보여요. 위젯이나 제어 센터, 단축어로는 언제든 바로 찍을 수 있어요." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejdřív uvidíš seznam prezentací. Z widgetu, Ovládacího centra nebo Zkratek můžeš kdykoli rovnou fotit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser dine præsentationer først. Fra widgetten, Kontrolcenter eller Genveje kan du altid gå direkte til kameraet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt zuerst deine Präsentationen. Über Widget, Kontrollzentrum oder Kurzbefehle kommst du jederzeit direkt zur Kamera."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφανίζει πρώτα τις παρουσιάσεις. Από το widget, το Κέντρο ελέγχου ή τις Συντομεύσεις ανοίγετε πάντα κατευθείαν την κάμερα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows your presentations first. You can always jump straight to the camera from the widget, Control Center or Shortcuts."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows your presentations first. You can always jump straight to the camera from the widget, Control Centre or Shortcuts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra primero tus presentaciones. Desde el widget, el Centro de control o Atajos siempre puedes ir directo a la cámara."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttää ensin esitykset. Widgetistä, Ohjauskeskuksesta tai Pikakomennoista pääset aina suoraan kameraan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche d’abord vos présentations. Le widget, le centre de contrôle ou Raccourcis ouvrent toujours directement l’appareil photo."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menampilkan daftar presentasi lebih dulu. Dari widget, Pusat Kontrol, atau Pintasan, Anda selalu bisa langsung memotret."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra prima le presentazioni. Dal widget, da Centro di Controllo o da Comandi puoi sempre andare subito alla fotocamera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "発表の一覧から始まります。ウィジェット、コントロールセンター、ショートカットからはいつでもすぐ撮れます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser presentasjonene først. Fra widgeten, Kontrollsenter eller Snarveier kan du alltid gå rett til kameraet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont eerst je presentaties. Via de widget, het bedieningspaneel of Opdrachten ga je altijd direct naar de camera."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najpierw pokazuje listę prezentacji. Z widżetu, centrum sterowania lub Skrótów zawsze możesz od razu robić zdjęcia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra primeiro suas apresentações. Pelo widget, Central de Controle ou Atalhos dá para ir direto à câmera."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала откроется список презентаций. Из виджета, Пункта управления или Команд можно сразу перейти к съёмке."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar presentationerna först. Från widgeten, Kontrollcenter eller Genvägar kommer du alltid direkt till kameran."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงรายการงานนำเสนอก่อน ถ่ายได้ทันทีจากวิดเจ็ต ศูนย์ควบคุม หรือคำสั่งลัดเสมอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önce sunumlarınızı gösterir. Widget'tan, Denetim Merkezi'nden veya Kestirmeler'den her zaman doğrudan çekebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiện danh sách bài thuyết trình trước. Bạn luôn có thể chụp ngay từ widget, Trung tâm điều khiển hoặc Phím tắt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先显示演示列表。随时可以通过小组件、控制中心或快捷指令直接拍摄。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先顯示簡報列表。隨時可以透過小工具、控制中心或捷徑直接拍攝。"
          }
        }
      }
    },
