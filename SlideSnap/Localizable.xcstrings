    "무료로는 발표를 %lld개까지 만들어요. 이미 담은 발표는 그대로 보고 내보낼 수 있어요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdarma můžeš vytvořit až %lld prezentací. Ty, které už máš, si dál můžeš prohlížet a exportovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis kan du oprette op til %lld præsentationer. Dem, du allerede har, kan du stadig se og eksportere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kostenlos kannst du bis zu %lld Präsentationen anlegen. Vorhandene Präsentationen kannst du weiterhin ansehen und exportieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δωρεάν μπορείτε να δημιουργήσετε έως %lld παρουσιάσεις. Όσες έχετε ήδη, τις βλέπετε και τις εξάγετε κανονικά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The free plan includes up to %lld presentations. You can still view and export the ones you already have."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The free plan includes up to %lld presentations. You can still view and export the ones you already have."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con el plan gratuito puedes crear hasta %lld presentaciones. Las que ya tienes puedes seguir viéndolas y exportándolas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilmaiseksi voit luoda enintään %lld esitystä. Jo olemassa olevia esityksiä voit edelleen katsoa ja viedä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La version gratuite permet jusqu’à %lld présentations. Celles que vous avez déjà restent consultables et exportables."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paket gratis bisa membuat hingga %lld presentasi. Presentasi yang sudah ada tetap bisa dilihat dan diekspor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con il piano gratuito puoi creare fino a %lld presentazioni. Quelle che hai già restano da vedere ed esportare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無料プランで作れるプレゼンは%lld件までです。作成済みのプレゼンはこれまでどおり見たり書き出したりできます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis kan du lage opptil %lld presentasjoner. De du allerede har, kan du fortsatt se og eksportere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis maak je tot %lld presentaties. Presentaties die je al hebt, kun je gewoon blijven bekijken en exporteren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W wersji darmowej możesz utworzyć do %lld prezentacji. Te, które już masz, nadal możesz przeglądać i eksportować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No plano grátis você cria até %lld apresentações. As que você já tem continuam disponíveis para ver e exportar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В бесплатной версии можно создать до %lld презентаций. Уже созданные презентации по-прежнему можно смотреть и экспортировать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis kan du skapa upp till %lld presentationer. De du redan har kan du fortfarande visa och exportera."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แบบฟรีสร้างงานนำเสนอได้สูงสุด %lld รายการ งานนำเสนอที่มีอยู่แล้วยังเปิดดูและส่งออกได้ตามเดิม"
          }
        },
        "tr" : {
          "stringUnit" : {
