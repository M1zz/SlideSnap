    "캘린더를 켜면 지금 진행 중인 일정 이름을 새 발표 이름으로 써요. 일정은 이 기기 안에서만 읽어요." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se zapnutým Kalendářem dostanou nové prezentace název právě probíhající události. Události se čtou jen v tomto zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med Kalender slået til får nye præsentationer navnet på den igangværende begivenhed. Begivenheder læses kun på denne enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Kalender heißen neue Präsentationen wie der laufende Termin. Termine werden nur auf diesem Gerät gelesen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με ενεργό το Ημερολόγιο, οι νέες παρουσιάσεις παίρνουν το όνομα του τρέχοντος συμβάντος. Τα συμβάντα διαβάζονται μόνο σε αυτή τη συσκευή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With Calendar on, new presentations take the name of the event happening now. Events are read only on this device."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With Calendar on, new presentations take the name of the event happening now. Events are read only on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con el Calendario activado, las presentaciones nuevas toman el nombre del evento en curso. Los eventos solo se leen en este dispositivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun Kalenteri on päällä, uudet esitykset saavat käynnissä olevan tapahtuman nimen. Tapahtumat luetaan vain tällä laitteella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec le Calendrier, les nouvelles présentations prennent le nom de l’événement en cours. Les événements sont lus uniquement sur cet appareil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan Kalender aktif, presentasi baru memakai nama acara yang sedang berlangsung. Acara hanya dibaca di perangkat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con il Calendario attivo, le nuove presentazioni prendono il nome dell’evento in corso. Gli eventi vengono letti solo su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カレンダーをオンにすると、進行中の予定の名前を新しい発表の名前にします。予定はこのデバイスの中でだけ読み取ります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med Kalender på får nye presentasjoner navnet på hendelsen som pågår. Hendelser leses bare på denne enheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met Agenda aan krijgen nieuwe presentaties de naam van het lopende agenda-item. Items worden alleen op dit apparaat gelezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po włączeniu Kalendarza nowe prezentacje dostają nazwę trwającego wydarzenia. Wydarzenia są czytane tylko na tym urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com a Agenda ativada, novas apresentações recebem o nome do evento em andamento. Os eventos são lidos só neste dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включить Календарь, новые презентации получат название текущего события. События читаются только на этом устройстве."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med Kalender på får nya presentationer namnet på den pågående händelsen. Händelser läses bara på den här enheten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเปิดปฏิทิน งานนำเสนอใหม่จะใช้ชื่อนัดที่กำลังดำเนินอยู่ นัดจะถูกอ่านบนอุปกรณ์นี้เท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takvim açıkken yeni sunumlar devam eden etkinliğin adını alır. Etkinlikler yalnızca bu cihazda okunur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bật Lịch, bài thuyết trình mới sẽ lấy tên sự kiện đang diễn ra. Sự kiện chỉ được đọc trên thiết bị này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启日历后，新演示会使用正在进行的日程名称。日程只在本设备上读取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟行事曆後，新簡報會使用正在進行的行程名稱。行程只在本裝置上讀取。"
          }
        }
      }
    },
