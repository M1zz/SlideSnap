        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca + in alto a destra per creare una presentazione\ne iniziare a catturare le diapositive."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右上の＋ボタンで新しいプレゼンを作成して、\nスライドを撮影してみましょう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på + øverst til høyre for å opprette en presentasjon\nog begynne å ta bilder av lysbilder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik rechtsboven op + om een presentatie aan te maken\nen begin met het vastleggen van dia's."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotknij „+” w prawym górnym rogu, aby utworzyć prezentację\ni zacząć fotografować slajdy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em + no canto superior direito para criar uma apresentação\ne começar a capturar slides."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите «+» в правом верхнем углу, чтобы создать презентацию\nи начать снимать слайды."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på + uppe till höger för att skapa en presentation\noch börja fotografera slides."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะ + ที่มุมขวาบนเพื่อสร้างงานนำเสนอ\nแล้วเริ่มถ่ายสไลด์ได้เลย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunum oluşturmak için sağ üstteki + düğmesine dokunun\nve slayt çekmeye başlayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn + ở góc trên bên phải để tạo bài thuyết trình\nvà bắt đầu chụp slide."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按右上角的 + 按钮新建演示，\n开始拍摄幻灯片吧。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下右上角的 + 按鈕新增簡報，\n開始拍攝投影片吧。"
          }
        }
      }
