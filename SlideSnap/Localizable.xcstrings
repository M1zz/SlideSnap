    "Siri에게 말하거나 단축어로 바로 장표를 찍어요." : {
      "comment" : "Roadmap item detail: Siri and Shortcuts",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Řekni to Siri nebo spusť zkratku a začni hned fotit slajdy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bed Siri eller kør en genvej for at begynde at tage billeder af slides med det samme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag es Siri oder starte einen Kurzbefehl, um sofort Folien aufzunehmen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ζητήστε το από τη Siri ή εκτελέστε μια συντόμευση για να ξεκινήσετε αμέσως τη λήψη διαφανειών."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask Siri or run a shortcut to start capturing slides right away."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask Siri or run a shortcut to start capturing slides right away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Díselo a Siri o usa un atajo para empezar a capturar diapositivas al instante."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyydä Siriä tai suorita pikakomento, niin kalvojen kuvaus alkaa heti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez à Siri ou lancez un raccourci pour capturer des diapositives aussitôt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minta Siri atau jalankan pintasan untuk langsung mulai memotret slide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi a Siri o avvia un comando rapido per catturare subito le diapositive."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siriに話しかけるか、ショートカットで、すぐにスライドを撮影できます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spør Siri eller kjør en snarvei for å begynne å ta bilder av lysbilder med én gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraag het aan Siri of start een opdracht om meteen dia's vast te leggen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poproś Siri lub uruchom skrót, aby od razu zacząć fotografować slajdy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peça à Siri ou use um atalho para começar a capturar slides na hora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попросите Siri или запустите команду, чтобы сразу начать снимать слайды."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fråga Siri eller kör en genväg för att börja fotografera slides direkt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สั่ง Siri หรือรันคำสั่งลัดเพื่อเริ่มถ่ายสไลด์ได้ทันที"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri'ye söyleyin ya da bir kısayol çalıştırıp hemen slayt çekmeye başlayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
