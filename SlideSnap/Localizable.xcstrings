    "받아쓰면 장표마다 그때 한 말을 볼 수 있고, 검색과 AI 요약에도 쓰여요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transcribe to see what was said on each slide. Transcripts are also used for search and AI Summary."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transcribe to see what was said on each slide. Transcripts are also used for search and AI Summary."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "转写后，可以查看每张幻灯片对应的讲解内容，也会用于搜索和 AI 摘要。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轉錄後，可以查看每張投影片對應的講解內容，也會用於搜尋和 AI 摘要。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字起こしすると、スライドごとにそのとき話した内容を確認でき、検索やAI要約にも使われます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расшифруйте запись, чтобы видеть, что говорили на каждом слайде. Текст также используется для поиска и саммари от ИИ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transcribe para ver lo que se dijo en cada diapositiva. Las transcripciones también se usan en la búsqueda y en el resumen con IA."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transkribiere die Aufnahme, um zu jeder Folie zu sehen, was dazu gesagt wurde. Die Transkripte fließen auch in die Suche und die KI-Zusammenfassung ein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transcrivez l’enregistrement pour voir ce qui a été dit sur chaque diapositive. Les transcriptions servent aussi à la recherche et au résumé IA."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascrivi per vedere cosa è stato detto in ogni diapositiva. Le trascrizioni servono anche per la ricerca e per il riepilogo IA."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transcreva para ver o que foi dito em cada slide. As transcrições também são usadas na busca e no Resumo com IA."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถอดเสียงเพื่อดูว่าแต่ละสไลด์พูดถึงอะไร ข้อความที่ถอดได้ยังใช้ค้นหาและให้ AI สรุปได้ด้วย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chép lời để xem người nói đã nói gì ở từng slide. Văn bản chép lời cũng được dùng để tìm kiếm và tóm tắt bằng AI."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahrávku přepiš a uvidíš, co zaznělo u kterého slajdu. Přepisy se využívají i při vyhledávání a pro shrnutí od AI."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transskribér for at se, hvad der blev sagt på hver slide. Transskriptioner bruges også til søgning og AI-resumé."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάντε μεταγραφή για να βλέπετε τι ειπώθηκε σε κάθε διαφάνεια. Οι μεταγραφές χρησιμοποιούνται και στην αναζήτηση και στη Σύνοψη AI."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Litteroimalla näet, mitä kullakin kalvolla sanottiin. Litteraatteja käytetään myös hakuun ja tekoälytiivistelmään."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transkripsikan untuk melihat apa yang disampaikan di setiap slide. Transkrip juga dipakai untuk pencarian dan Ringkasan AI."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transkriber for å se hva som ble sagt på hvert lysbilde. Transkripsjoner brukes også til søk og AI-sammendrag."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transcribeer de opname om te zien wat er bij elke dia is gezegd. Transcripties worden ook gebruikt voor zoeken en AI-samenvatting."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przepisz nagranie, aby zobaczyć, co powiedziano przy każdym slajdzie. Transkrypcje służą też do wyszukiwania i podsumowań AI."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transkribera för att se vad som sades på varje slide. Transkriptioner används också för sökning och AI-sammanfattning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her slaytta ne söylendiğini görmek için kaydı yazıya dökün. Dökümler arama ve Yapay Zeka Özeti için de kullanılır."
          }
        }
      }
    },
